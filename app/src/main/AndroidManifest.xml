<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The app talks to one thing: the blind relay, over HTTPS/WSS.

      CAMERA (QR pairing) and POST_NOTIFICATIONS are in the program spec but are NOT
      declared here. They arrive with the features that use them, in P1 and later. A
      permission declared before anything needs it is a permission that shows up in the
      store listing and the data-safety form with no honest justification behind it.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      allowBackup=false: the local replica is derived state, re-syncable from the PC, and
      must not travel through Google's backup transport. usesCleartextTraffic=false is the
      default from API 28 but is stated explicitly, because this app must never accept a
      plaintext relay connection and a default is not a commitment.
    -->
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CareerSeeker">

        <!-- No android:label here: it would repeat the application's, which lint flags
             as RedundantLabel. The activity inherits it. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CareerSeeker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
